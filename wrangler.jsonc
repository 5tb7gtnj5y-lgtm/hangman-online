{
  "name": "hangman-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "HangmanRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HangmanRoom"] }]
}
